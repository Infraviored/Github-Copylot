{
  "name": "GithubCopylot",
  "version": "1.1",
  "description": "Copy From Github copilot reviews directly, without having to wait for slow email receiveal...",
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
